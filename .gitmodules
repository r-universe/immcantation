[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "alakazam"]
	path = alakazam
	url = https://github.com/immcantation/alakazam
[submodule "dowser"]
	path = dowser
	url = https://github.com/immcantation/dowser
[submodule "scoper"]
	path = scoper
	url = https://github.com/immcantation/scoper
[submodule "shazam"]
	path = shazam
	url = https://github.com/immcantation/shazam
